# Copy to .env on each server and fill in for that host.

# Public domain the site is served on. Certs are expected at
# $CERT_DIR/live/$DOMAIN/{fullchain,privkey}.pem
DOMAIN=morse.clancarr.com

# Let's Encrypt root directory on the host (the one containing live/ and archive/).
CERT_DIR=/etc/letsencrypt

# Extra origins the backend allows for direct :8000 access (comma-separated).
# localhost and LAN dev origins are always allowed.
CORS_ORIGINS=http://morse.clancarr.com,https://morse.clancarr.com,http://138.68.179.160
